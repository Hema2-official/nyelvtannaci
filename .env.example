# To use a .env file in production, run as `node --env-file=.env build`

MTA_BASE_URL=https://helyesiras.mta.hu
# How many model responses one correction may consume (tool rounds + the final answer)
SESSION_MAX_TURNS=25

# Feature flags
# SESSION_REVIEW=on
# PARALLEL_SENTENCES=on

# Which OpenAI-compatible backend to talk to:
# openai | opencode-zen (zen) | opencode-go (go) | openrouter | custom
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.1

# --- OpenCode Zen ---
# LLM_PROVIDER=opencode-zen
# LLM_API_KEY=...
# LLM_MODEL=big-pickle

# --- OpenCode Go (subscription plan, separate model catalogue from Zen) ---
# LLM_PROVIDER=opencode-go
# LLM_API_KEY=...
# LLM_MODEL=kimi-k3

# --- OpenRouter ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o
# Optional attribution headers sent to OpenRouter
# LLM_APP_URL=https://example.com
# LLM_APP_NAME=Nyelvtannaci
# OPENROUTER_PRIORITIZE=throughput

# --- Any other OpenAI-compatible endpoint ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ignored
# LLM_MODEL=qwen3

# Reasoning budget. Left unset the model reasons at its own default, which is what you
# want for a reasoning model; a model without reasoning rejects the parameter outright.
# Accepted levels depend on the model (e.g. minimal | low | medium | high).
# LLM_REASONING_EFFORT=medium

# How many times a failed model request is retried (connection errors, 429, 5xx).
# LLM_MAX_RETRIES=5

# Overrides for provider quirks (defaults are derived from LLM_PROVIDER)
# LLM_BASE_URL=
# LLM_DEVELOPER_ROLE=false     # true only for OpenAI: use the `developer` role instead of `system`
# LLM_STRICT_TOOLS=false       # true only for OpenAI: strict-mode tool parameter schemas
# LLM_STRUCTURED_OUTPUTS=true  # `response_format: json_schema` for the final answer;
#                              # when false the result comes back via a `return_result` tool call

# --- Deployment (adapter-node) ---
# IP-based rate limiting is active, source IP is important.
# Behind a reverse proxy, set these:
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# --- Rate limiting ---
# Per address, per endpoint, over a sliding window held in memory (resets on restart).
# RATE_LIMIT=off           # switch all of it off
# RATE_LIMIT_WINDOW=60     # seconds the window covers
# RATE_LIMIT_CHECK=10      # corrections per window
# RATE_LIMIT_ANALYTICS=30  # analytics events per window

# Linked websites (omitted links won't appear)
# PUBLIC_DONATE_LINK=
# PUBLIC_REPO_LINK=
