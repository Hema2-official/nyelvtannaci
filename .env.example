MTA_BASE_URL=https://helyesiras.mta.hu
SESSION_MESSAGE_LIMIT=100

# Which OpenAI-compatible backend to talk to:
# openai | opencode-zen (zen) | opencode-go (go) | openrouter | custom
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# --- OpenCode Zen ---
# LLM_PROVIDER=opencode-zen
# LLM_API_KEY=...
# LLM_MODEL=big-pickle

# --- OpenCode Go (subscription plan, separate model catalogue from Zen) ---
# LLM_PROVIDER=opencode-go
# LLM_API_KEY=...
# LLM_MODEL=kimi-k3

# --- OpenRouter ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o
# Optional attribution headers sent to OpenRouter
# LLM_APP_URL=https://example.com
# LLM_APP_NAME=Nyelvtannaci

# --- Any other OpenAI-compatible endpoint ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ignored
# LLM_MODEL=qwen3

# Overrides for provider quirks (defaults are derived from LLM_PROVIDER)
# LLM_BASE_URL=
# LLM_DEVELOPER_ROLE=false  # true only for OpenAI: use the `developer` role instead of `system`
# LLM_STRICT_TOOLS=false    # true only for OpenAI: strict-mode tool parameter schemas
